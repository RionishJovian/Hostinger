# Copy to .env on the VPS. Secrets are separate files under ./secrets and must
# be readable only by the deployment operator.
POSTGRES_DB=mikromagic
POSTGRES_USER=mikromagic

# Keep :80 for an IP-only acceptance preview. Change to the real hostname only
# after DNS points to the VPS and TLS publication is explicitly approved.
MIKROMAGIC_SITE_ADDRESS=:80
MIKROMAGIC_HTTP_PORT=80
MIKROMAGIC_HTTPS_PORT=443

MIKROMAGIC_API_WORKERS=2
# Leave empty unless the exact private reverse-proxy IP is verified. Forwarded
# client-IP headers are ignored unless their immediate peer is trusted.
MIKROMAGIC_TRUSTED_PROXY_CIDRS=
MIKROMAGIC_MAX_SWITCHES_PER_SITE=1
MIKROMAGIC_MAX_APS_PER_SITE=5
MIKROMAGIC_SAFE_CHANGE_POLL_SECONDS=10

# Generate secrets/backup_key.txt separately with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Never put the generated value in this file, source control, logs, or support exports.
