FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends iproute2 wireguard-tools && rm -rf /var/lib/apt/lists/*
COPY requirements.hub.txt ./
RUN pip install --no-cache-dir --requirement requirements.hub.txt
COPY backend/__init__.py backend/hub_agent.py ./backend/
EXPOSE 51820/udp 8790/tcp 8791/tcp
HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=5 CMD ["python","-c","import urllib.request; urllib.request.urlopen('http://127.0.0.1:8790/health',timeout=3)"]
CMD ["uvicorn","backend.hub_agent:application","--factory","--host","0.0.0.0","--port","8790","--no-access-log"]
