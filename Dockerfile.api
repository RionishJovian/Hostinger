FROM python:3.12-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

RUN addgroup --system mikromagic && adduser --system --ingroup mikromagic mikromagic

COPY requirements.txt ./
RUN pip install --no-cache-dir --requirement requirements.txt

COPY alembic.ini ./
COPY backend ./backend
COPY docker/api-entrypoint.sh /usr/local/bin/mikromagic-api-entrypoint
RUN chmod 0555 /usr/local/bin/mikromagic-api-entrypoint \
    && mkdir -p /var/lib/mikromagic/backups /var/lib/mikromagic/routeros/monitoring /var/lib/mikromagic/routeros/safe-change /var/lib/mikromagic/routeros/enroll \
    && chown -R mikromagic:mikromagic /app /var/lib/mikromagic/backups /var/lib/mikromagic/routeros \
    && chmod 0700 /var/lib/mikromagic/backups /var/lib/mikromagic/routeros /var/lib/mikromagic/routeros/monitoring /var/lib/mikromagic/routeros/safe-change /var/lib/mikromagic/routeros/enroll

USER mikromagic
EXPOSE 8788

HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=5 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8788/v1/ready', timeout=3)" || exit 1

ENTRYPOINT ["mikromagic-api-entrypoint"]
